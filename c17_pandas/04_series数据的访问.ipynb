   "source": [
    "import pandas as pd\n",
    "\n",
    "s = pd.Series([3,4,5,6,7,8],index = ['a','b','c','d','e','f'])\n",
    "print(type(s['a']))\n",
    "print(s['a'])\n",
    "\n",
    "print(type(s[s > 4]))\n",
    "print(s[s > 4])\n",
    "print(s.head()) # 返回前五行数据\n",
    "print(s.tail()) # 返回后五行数据\n",
    "print(s.head(1)) # 返回前1行数据\n",
    "print(s.tail(2)) # 返回后1行数据"
   ],
